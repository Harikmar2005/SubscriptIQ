# SubscriptIQ Enterprise Environment Configuration Template
# Copy this file to .env and configure for your deployment environment

# Application & Server
ENVIRONMENT=production
PORT=3000

# Authentication & Cryptographic Security
# Generate via: openssl rand -hex 32
SECRET_KEY=your_secure_random_jwt_secret_key_min_32_chars

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://subflow_user:subflow_password@localhost:5432/subflow_enterprise
POSTGRES_USER=subflow_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=subflow_enterprise

# Cache & Celery Background Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Razorpay Payment Gateway (Test vs Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
IS_RAZORPAY_TEST_MODE=true

# AI & Optional Integrations
GEMINI_API_KEY=